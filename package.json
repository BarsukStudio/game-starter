{
  "name": "@barsuk/game-starter",
  "version": "0.1.0-alpha.23",
  "description": "The versioned platform contract and starter template shared by Barsuk Studio games",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    "./contract/manifest": "./contract/manifest.js",
    "./contract/runner": "./contract/runner.mjs",
    "./contract/cases": "./contract/cases/index.mjs",
    "./template/config-schema": "./template/schemas/config.schema.js",
    "./template/build-config-schema": "./template/schemas/build.config.schema.mjs",
    "./package.json": "./package.json",
    "./template/plugins-manifest": "./template/plugins-manifest.json",
    "./testing/native-ads": "./testing/native-ads.mjs"
  },
  "files": [
    "contract",
    "template",
    "tools",
    "PLUGINS.md",
    "testing"
  ],
  "scripts": {
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BarsukStudio/game-starter.git"
  },
  "sideEffects": false,
  "bin": {
    "barsuk-verify-plugins": "./tools/verify-plugin-setup.mjs",
    "barsuk-compare-template": "./tools/compare-template.mjs",
    "barsuk-export-template": "./tools/export-template.mjs"
  }
}
